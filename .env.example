# Azure AD / Entra ID Configuration
# Client ID from your Entra ID app registration
NEXT_PUBLIC_MSAL_CLIENT_ID=your-client-id-here

# Optional. In the browser the app always uses the page's own origin as the
# redirect URI, so every origin it is served from (apex, www, localhost) must be
# registered as a Single-page application redirect URI on the app registration.
# This value is only a fallback during server-side rendering.
NEXT_PUBLIC_MSAL_REDIRECT_URI=http://localhost:4000
